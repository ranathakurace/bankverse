{
  "name": "bankverse-automation",
  "version": "1.0.0",
  "private": true,
  "description": "BankVerse UI and API acceptance tests",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "browsers:install": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "dotenv": "18.0.8",
    "typescript": "7.0.2"
  }
}
