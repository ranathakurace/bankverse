# Default: start a disposable application on port 18080 with an in-memory database.
START_APP=true
TEST_PORT=18080
TEST_WORKERS=2
# Existing QA environment: START_APP=false, set both URLs and credentials.
# API_BASE_URL=https://qa.bankverse.example
# UI_BASE_URL=https://qa.bankverse.example
# TEST_USERNAME=automation-admin
# TEST_PASSWORD=use-a-secret-store
# Explicit opt-in to persistent customer creation on an existing QA environment.
ALLOW_TEST_DATA=false
